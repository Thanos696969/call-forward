    "test": "vitest run",
    "simulate-call": "tsx scripts/simulate-call.ts",
    "load-smoke": "tsx scripts/load-smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@relay/core": "workspace:*",
    "@relay/db": "workspace:*",
    "@relay/routing": "workspace:*",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "testcontainers": "12.2.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
