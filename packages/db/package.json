    "reset": "tsx scripts/reset.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@relay/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
