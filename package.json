{
  "name": "callflow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@relay/web --filter=@relay/api --filter=@relay/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "e2e": "pnpm --filter @relay/web e2e",
    "db:migrate": "pnpm --filter @relay/db migrate",
    "db:seed": "pnpm --filter @relay/db seed",
    "db:reset": "pnpm --filter @relay/db reset",
    "simulate-call": "pnpm --filter @relay/api simulate-call",
    "load:smoke": "pnpm --filter @relay/api load-smoke"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "cpu-features",
      "ssh2",
      "protobufjs",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
