# Copy to .env and adjust. Every value below has a working local default, so a
# fresh clone runs without a .env file. Values marked REQUIRED IN PRODUCTION
# have no safe default outside local development.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Data stores (match docker-compose.yml) ──────────────────────────────────
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379

# ── API service (apps/api) ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Public base URL the carrier uses to reach the voice webhooks.
# For real Twilio calls this must be a public HTTPS URL (e.g. an ngrok tunnel).
PUBLIC_API_URL=http://localhost:4000
# Browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Base URL used in emails (password reset links).
WEB_URL=http://localhost:3000
# Comma-separated proxy addresses whose X-Forwarded-For header is trusted.
TRUST_PROXY=127.0.0.1,::1
# Set false only in automated tests.
RATE_LIMIT_ENABLED=true
# Defaults to true when NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# Where Next.js proxies the API paths (/api/v1, /voice, /healthz, /readyz, /api/cron).
# Leave unset on Vercel: there the API runs inside the Next.js app (see docs/DEPLOY-VERCEL.md).
API_URL=http://localhost:4000
# Run the API inside Next.js without Vercel (e.g. `next start` on one server). Ignored if API_URL is set.
# EMBED_API=true

# ── Telephony ───────────────────────────────────────────────────────────────
# mock | twilio | telnyx. When unset: twilio if TWILIO_* are set, otherwise mock.
TELEPHONY_PROVIDER=mock
# Shared secret for signing simulated webhooks to the mock provider.
# REQUIRED IN PRODUCTION if TELEPHONY_PROVIDER=mock (it should not be).
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
# Twilio (REQUIRED when TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Override only for tests against a recorded/fake Twilio API.
TWILIO_API_BASE=https://api.twilio.com

# ── Email (mailpit locally: UI at http://localhost:8025) ───────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Relay <no-reply@relay.local>

# ── Serverless (Vercel) ─────────────────────────────────────────────────────
# Set automatically on Vercel: VERCEL, VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL.
# PUBLIC_API_URL, WEB_URL and WEB_ORIGIN default to https://$VERCEL_PROJECT_PRODUCTION_URL.
# Neon (Vercel Storage) sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (migrations).
# Upstash (Vercel Storage) sets REDIS_URL / KV_URL; either is accepted.
# queue = BullMQ + apps/worker; inline = jobs and maintenance inside the API (default on Vercel).
# JOBS_MODE=queue
# Postgres connections per API instance (default 20, or 5 on Vercel).
# DB_POOL_MAX=20
# Random secret; Vercel Cron sends it to /api/cron/maintenance (the route is off without it).
# CRON_SECRET=
# Demo deployments only: allow the mock carrier in production (needs a 24+ character MOCK_WEBHOOK_SECRET).
# ALLOW_MOCK_PROVIDER=false
# Preview deploys skip migrations unless this is true (use a separate preview database).
# RUN_MIGRATIONS=false
